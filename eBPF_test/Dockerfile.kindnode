FROM kindest/node:v1.33.1@sha256:050072256b9a903bd914c0b2866828150cb229cea0efe5892e2b644d5dd3b34f

# Install lightweight runtime/debug tools only.
# BPF compilation toolchain (clang, llvm, etc.) lives in the builder image,
# not here — heavy packages break Kind's systemd boot.
RUN apt-get update && \
    apt-get install -y \
        tcpdump \
        iputils-ping \
        traceroute \
        iproute2 \
        iptables \
        ethtool \
        conntrack \
        dnsutils \
        netcat-openbsd \
        curl \
        vim \
        bpftool \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
